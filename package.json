{
  "name": "@webship-js/mediawiki-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for MediaWiki, a plugin for webship-js (Playwright and Cucumber): reading a page with its contents list, sections, links, references and categories; the search box with its suggestions and the results page; the source editor (summary, minor edit, preview, changes, edit conflicts) and the visual editor; the history (compare, undo), talk pages, the category tree, the watchlist, recent changes and preferences; file uploads; protecting, deleting, restoring and blocking; login, logout and account creation refusals.",
  "main": "tests/step-definitions/mediawiki-session.steps.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "tests/fixtures/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "mediawiki",
    "wiki",
    "visualeditor",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/mediawiki-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/mediawiki-steps/issues"
  },
  "homepage": "https://github.com/webship/mediawiki-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
